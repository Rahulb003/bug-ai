PORT=8080
# Optional: enables structured AI reasoning in addition to deterministic analysis.
GEMINI_API_KEY=
# Use a long random value in production.
JWT_SECRET=change-this-in-production

# Experimental: process-level sandboxed execution for the /api/verify action.
# This is Node's Permission Model in a child process, NOT container/OS isolation,
# and it does NOT restrict network access. Leave false unless you understand that.
EXECUTION_SANDBOX_ENABLED=false
